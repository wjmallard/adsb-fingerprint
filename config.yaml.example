# Copy to config.yaml (gitignored) and edit for your setup.

database:
  dbname: radio_classifier

paths:
  # Raw IQ captures — the source of truth. ~ is expanded.
  captures: ~/radio-classifier-data/captures
  # Model checkpoints — one directory per adsb-train run.
  models: ~/radio-classifier-data/models

radio:
  center_freq_hz: 1090000000   # ADS-B / Mode S downlink
  sample_rate_hz: 2400000      # RTL2832U stable max ~2.4 MSPS
  gain: auto                   # "auto" or a dB value like 40.0
  freq_correction_ppm: 0       # your dongle's measured PPM offset

collect:
  # Micro-cluster sampling: the first N messages per window arrive back-to-back
  # (tight replicates -> per-message noise floor); successive windows sample
  # fresh geometry along the flight path. Ident messages (TC 1-4, callsign) are
  # exempt from the cap, with their own allowance of 1 per window.
  max_per_aircraft: 3          # keep at most this many messages per aircraft ...
  window_seconds: 10           # ... per this many seconds (0 disables the cap)

receiver:
  latitude: 37.62              # your approximate location, for ADS-B position decode
  longitude: -122.38

server:
  host: 127.0.0.1
  port: 5050                   # offline-maps owns 5000
  debug: true

map:
  # Basemap shared with the offline-maps project (contiguous-US Protomaps
  # extract, z0-15) — nothing here ever fetches tiles from the network.
  tiles_file: ~/Github/offline-maps/data/basemap.pmtiles
  default_zoom: 8              # wide enough to show the outer range ring
  roster_minutes: 15           # roster window: aircraft heard this recently
  rings_km: [50, 100, 150]     # range rings around the receiver
